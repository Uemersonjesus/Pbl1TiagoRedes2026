FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY internal ./internal
COPY cmd/motorista ./cmd/motorista
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/vaijunto-motorista ./cmd/motorista

FROM alpine:3.20
COPY --from=build /out/vaijunto-motorista /usr/local/bin/vaijunto-motorista
ENTRYPOINT ["/usr/local/bin/vaijunto-motorista"]
